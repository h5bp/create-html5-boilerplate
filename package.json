{
  "name": "create-html5-boilerplate",
  "version": "1.0.0",
  "description": "An npm based quickstart app for HTML5-Boilerplate",
  "keywords": [],
  "homepage": "https://html5boilerplate.com/",
  "bugs": {
    "url": "https://github.com/h5bp/create-html5-boilerplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/h5bp/create-html5-boilerplate.git"
  },
  "license": "MIT",
  "author": "@h5bp",
  "main": "src/generator.js",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "bin": {
    "create-html5-boilerplate": "./index.js"
  },
  "scripts": {
    "test": "npm run typecheck && node --test",
    "test:watch": "node --test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write index.js src/*.js src/*.d.ts tests/*.js eslint.config.js package.json tsconfig.json .github/workflows/*.yml",
    "format:check": "prettier --check index.js src/*.js src/*.d.ts tests/*.js eslint.config.js package.json tsconfig.json .github/workflows/*.yml",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=\"src/*.js\"",
    "acm:validate": "acm-cli validate --file",
    "prepare": "husky"
  },
  "files": [
    "lib/**/*",
    "src/**/*",
    "license.txt",
    "index.js",
    "README.md"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "compare-versions": "^6.1.1",
    "elapsed-time-logger": "^1.1.7",
    "fast-glob": "^3.3.3",
    "fuzzy": "^0.1.3",
    "inquirer": "^9.3.8",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "npm-pick-manifest": "^9.1.0",
    "ora": "^7.0.1",
    "ssri": "^11.0.0",
    "tar": "^7.5.22"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@roblarsen/acm-cli": "^1.1.0",
    "@types/inquirer": "^9.0.10",
    "@types/inquirer-autocomplete-prompt": "^3.0.4",
    "@types/node": "^20.0.0",
    "@types/ssri": "^7.1.5",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2",
    "typescript": "^5.9.3"
  }
}

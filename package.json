{
  "name": "create-html5-boilerplate",
  "version": "1.0.0",
  "description": "An npm based quickstart app for HTML5-Boilerplate",
  "keywords": [],
  "homepage": "https://html5boilerplate.com/",
  "bugs": {
    "url": "https://github.com/h5bp/create-html5-boilerplate/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/h5bp/create-html5-boilerplate.git"
  },
  "license": "MIT",
  "author": "@h5bp",
  "main": "index.js",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "bin": {
    "create-html5-boilerplate": "./index.js"
  },
  "scripts": {
    "test": "node --test",
    "test:watch": "node --test --watch",
    "lint": "eslint .",
    "format": "prettier --write index.js lib/cli.js tests/*.js eslint.config.js package.json .github/workflows/*.yml",
    "format:check": "prettier --check index.js lib/cli.js tests/*.js eslint.config.js package.json .github/workflows/*.yml",
    "coverage": "node --test --experimental-test-coverage --test-coverage-include=lib/cli.js",
    "prepare": "husky"
  },
  "files": [
    "lib/**/*",
    "license.txt",
    "index.js",
    "README.md"
  ],
  "dependencies": {
    "chalk": "^5.6.2",
    "compare-versions": "^6.1.1",
    "elapsed-time-logger": "^1.1.7",
    "fast-glob": "^3.3.3",
    "fs-extra": "^11.4.1",
    "fuzzy": "^0.1.3",
    "inquirer": "^9.3.8",
    "inquirer-autocomplete-prompt": "^3.0.1",
    "ora": "^7.0.1",
    "pacote": "^21.5.3",
    "yargs-parser": "^21.1.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.10",
    "pretty-quick": "^4.2.2"
  }
}
